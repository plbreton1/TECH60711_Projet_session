# Copiez ce fichier sous le nom .env et remplissez les valeurs. Ne versionnez JAMAIS le fichier .env.

# "openai" pour un vrai appel, "fictif" pour tester sans clé (réponse fixe, ne démontre pas l'IA)
LLM_MODE=openai

# Créez votre propre clé ici : https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Nom exact du modèle. Vérifiez les modèles offerts : https://platform.openai.com/docs/models
OPENAI_MODEL=

# Taille du modèle Whisper local : tiny, base, small (défaut), medium. Plus gros = plus précis mais plus lent.
WHISPER_MODEL=small
